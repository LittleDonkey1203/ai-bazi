{
  "name": "bazi-mcp",
  "version": "0.1.0",
  "type": "module",
  "module": "./src/smithery.ts",
  "devDependencies": {
    "@tsconfig/node22": "^22.0.1",
    "@types/express": "^5.0.3",
    "@types/node": "^22.14.1",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cantian-ai/bazi-mcp.git"
  },
  "keywords": [
    "bazi",
    "八字",
    "mcp",
    "算命",
    "命理"
  ],
  "license": "ISC",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true});\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "tsc": "npm run build",
    "prepublishOnly": "npm run build && node -e \"const fs=require('fs'); if (fs.existsSync('dist/stdio.js')) fs.chmodSync('dist/stdio.js',0o755);\"",
    "smithery-dev": "npx @smithery/cli dev",
    "start": "npm run build && node dist/httpServer.js",
    "start:http": "node dist/httpServer.js"
  },
  "bin": {
    "bazi-mcp": "./dist/stdio.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2",
    "cantian-tymext": "^0.0.21",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "express": "^5.1.0",
    "tsx": "^4.20.5",
    "tyme4ts": "^1.3.4",
    "zod": "^3.24.3"
  }
}
