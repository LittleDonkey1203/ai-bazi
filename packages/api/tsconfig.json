{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "moduleResolution": "bundler",
    "module": "ESNext",
    "types": ["node"],
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": false
  },
  "include": ["src/**/*", "__tests__/**/*"],
  "exclude": ["dist", "node_modules"]
}
