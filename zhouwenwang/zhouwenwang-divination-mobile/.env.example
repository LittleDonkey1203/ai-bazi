# =============================================================================
# zhouwenwang-divination-mobile 环境变量示例
# =============================================================================
#
# 用法:
#   cp .env.example .env.local
#   编辑 .env.local 填入真实值
#   .env.local 已在 .gitignore，不会被推到远端
#
# 注意:
#   Vite 仅暴露 VITE_ 前缀的变量到客户端代码（import.meta.env.VITE_*）
#   所有 key 都会被打包进客户端 bundle，不要写真实的服务端 secret
#

# === Gemini API 配置 ===

# Gemini API endpoint
# 留空则使用 Google 官方 endpoint（默认行为，向后兼容）
# 替换为 viviai.cc / oneapi 等 Gemini 兼容代理示例:
#   VITE_GEMINI_BASE_URL=https://api.viviai.cc/v1beta/models
VITE_GEMINI_BASE_URL=

# Gemini API key 预填
# 留空则用户在 SettingsModal UI 中配置（存 localStorage）
# 填值时应保证此文件不进 git
VITE_GEMINI_API_KEY=

# === 自建后端服务器（可选，与 Gemini 直连二选一）===

# 留空走默认逻辑（dev: localhost:3001 / prod: 同源）
# VITE_SERVER_URL=http://localhost:3001
